# aerolab_embed_file(INPUT <file> OUTPUT <file.cc> NAMESPACE <ns> SYMBOL <name>)
#
# Generates a C++ source defining
#   extern const unsigned char <name>[];
#   extern const std::size_t <name>Size;
# inside namespace <ns>, holding the bytes of <file>. Runs at configure time
# and again whenever <file> changes, so binaries need no runtime assets. The
# output is only rewritten when its contents change, so reconfiguring does
# not force a recompile.

function(aerolab_embed_file)
  cmake_parse_arguments(ARG "" "INPUT;OUTPUT;NAMESPACE;SYMBOL" "" ${ARGN})
  if(NOT EXISTS "${ARG_INPUT}")
    message(FATAL_ERROR "aerolab_embed_file: input not found: ${ARG_INPUT}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ARG_INPUT}")

  file(READ "${ARG_INPUT}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR byte_count "${hex_length} / 2")
  if(byte_count EQUAL 0)
    message(FATAL_ERROR "aerolab_embed_file: input is empty: ${ARG_INPUT}")
  endif()

  # Two hex digits per byte -> "0xNN,", then a line break every 16 bytes.
  # (CMake regular expressions have no {n} quantifier, so the 16-byte group
  # is spelled out.)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REPEAT "0x[0-9a-f][0-9a-f]," 16 sixteen_bytes)
  string(REGEX REPLACE "(${sixteen_bytes})" "\\1\n" bytes "${bytes}")

  # string(CONCAT) keeps the semicolons that a list-based set() would eat.
  string(CONCAT content
    "// Generated by cmake/AerolabEmbedFile.cmake from\n"
    "// ${ARG_INPUT}. Do not edit.\n\n"
    "#include <cstddef>\n\n"
    "namespace ${ARG_NAMESPACE} {\n\n"
    "extern const unsigned char ${ARG_SYMBOL}[];\n"
    "extern const std::size_t ${ARG_SYMBOL}Size;\n\n"
    "alignas(16) const unsigned char ${ARG_SYMBOL}[] = {\n${bytes}\n};\n"
    "const std::size_t ${ARG_SYMBOL}Size = ${byte_count};\n\n"
    "}  // namespace ${ARG_NAMESPACE}\n")

  set(existing "")
  if(EXISTS "${ARG_OUTPUT}")
    file(READ "${ARG_OUTPUT}" existing)
  endif()
  if(NOT existing STREQUAL content)
    file(WRITE "${ARG_OUTPUT}" "${content}")
  endif()
endfunction()
